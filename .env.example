# Server
NODE_ENV=development
API_PORT=3001

# Public API base URL used by the frontend only
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Server-side database configuration. Never expose these through VITE_* variables.
DATABASE_URL=

# Optional production CORS allow-list (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
